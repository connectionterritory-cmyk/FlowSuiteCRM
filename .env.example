NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
GOOGLE_GEOCODING_API_KEY=
OUTBOX_N8N_WORKER_SECRET=

# Shared secret trusted callers (n8n, worker scripts) send as the
# X-FlowSuite-Worker-Secret header to process-outbox and dispatch-campaign.
# Must also be set as a Supabase Edge Function secret in every environment
# that calls those functions without a user session (supabase secrets set
# OUTBOX_WORKER_SECRET=...). Without it, those callers get 401.
OUTBOX_WORKER_SECRET=
