CREATE OR REPLACE FUNCTION public.fn_convertir_lead_a_cliente(p_lead_id uuid, p_actor_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_lead record;
  v_cliente_id uuid;
begin
  -- Lock the row so a concurrent call blocks here instead of racing past this check.
  select * into v_lead from leads where id = p_lead_id and deleted_at is null for update;
  if not found then
    return jsonb_build_object('error', 'lead_not_found');
  end if;

  if v_lead.estado_pipeline in ('cierre', 'descartado') then
    return jsonb_build_object('error', 'lead_not_active');
  end if;

  insert into clientes (
    nombre, apellido, email, telefono, direccion, ciudad, estado_region, codigo_postal, apartamento,
    vendedor_id, org_id, persona_id, fecha_nacimiento,
    origen, fecha_cierre, activo, saldo_actual, monto_moroso, dias_atraso,
    whatsapp_opt_in, whatsapp_no_molestar, whatsapp_consent_source, whatsapp_consented_at
  )
  values (
    v_lead.nombre, v_lead.apellido, v_lead.email, v_lead.telefono, v_lead.direccion, v_lead.ciudad, v_lead.estado_region, v_lead.codigo_postal, v_lead.apartamento,
    v_lead.vendedor_id, v_lead.org_id, v_lead.persona_id, v_lead.fecha_nacimiento,
    'lead_convertido', current_date, true, 0, 0, 0,
    v_lead.whatsapp_opt_in, v_lead.whatsapp_no_molestar, v_lead.whatsapp_consent_source, v_lead.whatsapp_consented_at
  )
  returning id into v_cliente_id;

  update leads
     set estado_pipeline = 'cierre',
         updated_at = now(),
         updated_by = coalesce(p_actor_id, updated_by)
   where id = p_lead_id;

  return jsonb_build_object('cliente_id', v_cliente_id, 'lead_id', p_lead_id);
end;
$function$;

CREATE OR REPLACE FUNCTION public.is_admin()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'extensions'
AS $function$
  select exists (
    select 1 from public.usuarios
    where id = auth.uid() and rol = 'admin'
  );
$function$;

CREATE OR REPLACE FUNCTION public.is_distribuidor()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'extensions'
AS $function$
  select exists (
    select 1 from public.usuarios
    where id = auth.uid() and rol = 'distribuidor'
  );
$function$;

CREATE OR REPLACE FUNCTION public.is_distribuidor_of(vendor_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public', 'extensions'
AS $function$
  select exists (
    select 1 from public.usuarios u
    where u.id = vendor_id
      and u.distribuidor_padre_id = auth.uid()
  );
$function$;
ALTER TABLE public.ventas ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.venta_items ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.venta_transacciones ENABLE ROW LEVEL SECURITY;
CREATE POLICY "venta_items_inherit_ventas" ON public.venta_items FOR ALL TO authenticated USING (((org_id IS NOT NULL) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM ventas v
  WHERE ((v.id = venta_items.venta_id) AND (v.org_id = venta_items.org_id)))))) WITH CHECK (((org_id IS NOT NULL) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM ventas v
  WHERE ((v.id = venta_items.venta_id) AND (v.org_id = venta_items.org_id))))));
CREATE POLICY "venta_transacciones_inherit_ventas" ON public.venta_transacciones FOR ALL TO authenticated USING (((org_id IS NOT NULL) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM ventas v
  WHERE ((v.id = venta_transacciones.venta_id) AND (v.org_id = venta_transacciones.org_id)))))) WITH CHECK (((org_id IS NOT NULL) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM ventas v
  WHERE ((v.id = venta_transacciones.venta_id) AND (v.org_id = venta_transacciones.org_id))))));
CREATE POLICY "ventas_admin_all" ON public.ventas FOR ALL TO authenticated USING ((is_admin() AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))))) WITH CHECK ((is_admin() AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid())))));
CREATE POLICY "ventas_distribuidor_all" ON public.ventas FOR ALL TO authenticated USING ((is_distribuidor() AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND ((vendedor_id = auth.uid()) OR is_distribuidor_of(vendedor_id) OR (EXISTS ( SELECT 1
   FROM clientes c
  WHERE ((c.id = ventas.cliente_id) AND (c.org_id = ventas.org_id) AND ((c.distribuidor_id = auth.uid()) OR (c.vendedor_id = auth.uid()) OR is_distribuidor_of(c.vendedor_id)))))))) WITH CHECK ((is_distribuidor() AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND ((vendedor_id = auth.uid()) OR is_distribuidor_of(vendedor_id) OR (EXISTS ( SELECT 1
   FROM clientes c
  WHERE ((c.id = ventas.cliente_id) AND (c.org_id = ventas.org_id) AND ((c.distribuidor_id = auth.uid()) OR (c.vendedor_id = auth.uid()) OR is_distribuidor_of(c.vendedor_id))))))));
CREATE POLICY "ventas_supervisor_tele_read" ON public.ventas FOR SELECT TO authenticated USING (((EXISTS ( SELECT 1
   FROM usuarios u
  WHERE ((u.id = auth.uid()) AND (u.rol = 'supervisor_telemercadeo'::usuario_rol)))) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid())))));
CREATE POLICY "ventas_tele_read" ON public.ventas FOR SELECT TO authenticated USING (((EXISTS ( SELECT 1
   FROM usuarios u
  WHERE ((u.id = auth.uid()) AND (u.rol = 'telemercadeo'::usuario_rol)))) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))) AND (EXISTS ( SELECT 1
   FROM (clientes c
     JOIN tele_vendedor_assignments t ON ((t.tele_id = auth.uid())))
  WHERE ((c.id = ventas.cliente_id) AND (c.org_id = ventas.org_id) AND ((t.vendedor_id = c.vendedor_id) OR (t.vendedor_id = c.distribuidor_id)))))));
CREATE POLICY "ventas_vendedor_all" ON public.ventas FOR ALL TO authenticated USING (((EXISTS ( SELECT 1
   FROM usuarios u
  WHERE ((u.id = auth.uid()) AND (u.rol = 'vendedor'::usuario_rol)))) AND (vendedor_id = auth.uid()) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid()))))) WITH CHECK (((EXISTS ( SELECT 1
   FROM usuarios u
  WHERE ((u.id = auth.uid()) AND (u.rol = 'vendedor'::usuario_rol)))) AND (vendedor_id = auth.uid()) AND (org_id = ( SELECT u.org_id
   FROM usuarios u
  WHERE (u.id = auth.uid())))));
GRANT USAGE ON SCHEMA public, auth TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO authenticated;
