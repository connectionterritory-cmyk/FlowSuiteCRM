-- Isolated fixture: production column types, conversion implementation and sales RLS
-- inspected read-only 2026-09-20. Synthetic records only; not a full schema dump.
CREATE ROLE anon; CREATE ROLE authenticated;
CREATE SCHEMA auth;
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(current_setting('request.jwt.claim.sub', true), '')::uuid
$$;
CREATE TYPE public.usuario_rol AS ENUM ('admin','distribuidor','vendedor','telemercadeo','supervisor_telemercadeo','embajador');
CREATE TYPE public.venta_tipo_movimiento AS ENUM ('venta_inicial','agregado');
CREATE TYPE public.lead_estado_pipeline AS ENUM ('nuevo','contactado','calificado','descartado','cita','demo','cierre');
